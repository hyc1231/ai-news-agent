# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 模型调用韧性配置（可选，不填用默认值）
# LLM_TIMEOUT=60            单次请求超时秒数
# LLM_MAX_RETRIES=2         失败后的额外重试次数（可恢复错误才重试）
# LLM_RETRY_BACKOFF=1.5     指数退避基数（秒）
# LLM_MAX_TOKENS=           留空用服务端默认；过小会导致简报被截断

# 邮件发送配置（SMTP）
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password_or_app_password
FROM_EMAIL=your_email@example.com

# 默认收件人：preferences 里没填邮箱时由它兜底（也可在前端「设置」里改）
DEFAULT_RECIPIENT=your_email@example.com

# 数据库配置
# DB_TYPE=mysql 用 MySQL；不填或 sqlite 用 SQLite（零依赖，便于 5 分钟跑起来）
DB_TYPE=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_news_agent

# 接口安全配置（可选）
# API_KEY 留空 = 不启用鉴权，本机零配置即可用；填了值则所有 /api 接口都要求请求头 X-API-Key
API_KEY=
# 允许跨域的来源，逗号分隔；不填时默认只允许本机 http://127.0.0.1:8000 与 http://localhost:8000
CORS_ORIGINS=

# 定时任务配置
SCHEDULE_TIME=08:00
TIMEZONE=Asia/Shanghai
# 多 worker 部署时设为 false，再单独跑一个 python scheduler.py
ENABLE_SCHEDULER=true

# Tavily API 配置（推荐，通用 AI 搜索）
TAVILY_API_KEY=your_tavily_api_key
TAVILY_ENDPOINT=https://api.tavily.com/search

# 搜索质量与时效配置
RELEVANCE_THRESHOLD=6
NEWS_QUERY_SUFFIX=新闻 最新
# 时效窗口：只推送最近 N 天内发布的新闻。1 = 只看今天；2 = 今天+昨天；7 = 近一周；0 = 不做时间过滤
NEWS_MAX_AGE_DAYS=1
# 发布时间无法确认的条目：false = 保留但标注「发布时间未确认」；true = 一律丢弃（最严格）
NEWS_STRICT_DATE=false

# Bing Web Search API 配置（可选，Tavily 失败时回退）
BING_SEARCH_KEY=your_bing_search_key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/news/search
